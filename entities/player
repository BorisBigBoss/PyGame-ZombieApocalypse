import pygame
from pygame.math import Vector2
from ZombieApocalypse.utils.colors import Colors  # ← убедитесь, что папка utils существует

class Player:
    def __init__(self, x, y):  # ✅ Двойные подчеркивания обязательны!
        self.x = x
        self.y = y
        self.color = Colors.BLUE
        self.hp = 100
        self.velocity = Vector2(0, 0)
        self.radius = 10

    def draw(self, screen):
        # .value превращает Enum в кортеж RGB, int() защищает от ошибки дробных координат
        pygame.draw.circle(screen, self.color.value, (int(self.x), int(self.y)), self.radius)
